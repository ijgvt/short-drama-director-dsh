# Dependencies (never track; installed per machine)
node_modules/

# Local snapshots taken by hand before risky edits
_snapshots/
_snapshot/
*.bak
*.bak-*
*.orig
*.orig-user

# Editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Logs and throwaway probes
*.log
_probe-*.mjs
_tmp-*.mjs
_rebuild-*.mjs

# Test output that is regenerated by the suite
test-output/
coverage/
release/

# Local credentials and package artifacts
.env
.env.*
*.tgz

# User projects are deliberately outside this repository. They hold private assets,
# prompts, generated media, and multi-GB renders; version control here is for the
# plugin's code and skills only.
